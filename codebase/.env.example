# Copy this file to .env and put your real key there.
# Do not commit your real .env file.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
# auto: OpenAI when a key exists, otherwise a clearly labelled degraded result.
# openai: require OpenAI; errors return AI_UNAVAILABLE and never raw fallback.
# extractive: explicit offline/debug mode only.
AI_GENERATION_MODE=auto
OPENAI_ANSWER_TIMEOUT_SECONDS=12
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=700
VLEARN_RECALL_HOST=127.0.0.1
VLEARN_RECALL_PORT=8011
# "null" lets index.html call the local API when opened directly via file://.
VLEARN_CORS_ORIGINS=null,http://127.0.0.1:8011,http://localhost:8011
RAG_INDEX_MODE=persistent
RAG_AUTO_REFRESH=true
RAG_INDEX_DIR=data/.rag-index
RAG_EMBEDDING_MODEL=auto
# Explicit opt-in: true sends bounded slide/transcript chunks to OpenAI once
# to build dense vectors. OPENAI_API_KEY alone does not enable this.
RAG_DENSE_ENABLED=false
RAG_DENSE_MODEL=text-embedding-3-small
RAG_DENSE_DIMENSIONS=256
RAG_DENSE_BATCH_SIZE=64
RAG_DENSE_TIMEOUT_SECONDS=30
RAG_DENSE_MAX_CHARS=1200
RAG_RERANK_ENABLED=true
RAG_VISION_ENABLED=true
RAG_VISION_MAX_TEXT_CHARS=280
RAG_VISION_RENDER_SCALE=2.0
RAG_VISION_TIMEOUT_SECONDS=60
